PLANNER_ENVIRONMENT=development
PLANNER_DATABASE_URL=sqlite:///./personal_planner.db
PLANNER_API_PREFIX=/api/v1
PLANNER_FRONTEND_ORIGINS=["http://localhost:5173"]
PLANNER_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Proxies that append X-Forwarded-For between the client and the app: 0 in local
# development, 1 behind the Railway edge. Never raise it above the real hop count.
PLANNER_TRUSTED_PROXY_HOPS=0
PLANNER_MAX_REQUEST_BYTES=65536
PLANNER_BOOTSTRAP_ADMIN_USERNAME=admin
PLANNER_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrador
PLANNER_BOOTSTRAP_ADMIN_PASSWORD=pleno-local-2026
