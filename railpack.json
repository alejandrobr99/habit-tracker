{
  "$schema": "https://schema.railpack.com",
  "provider": "shell",
  "packages": {
    "node": "22",
    "python": "3.11",
    "uv": "0.7.21"
  },
  "steps": {
    "install": {
      "inputs": [
        {
          "step": "packages:mise"
        },
        {
          "local": true,
          "include": [
            "."
          ]
        }
      ],
      "commands": [
        {
          "cmd": "npm --prefix /app/frontend ci",
          "customName": "Instalar frontend"
        },
        {
          "cmd": "uv --directory /app/backend sync --frozen --no-dev",
          "customName": "Instalar backend"
        },
        {
          "cmd": "sh -c 'test -x /app/backend/venv/bin/alembic && test -x /app/backend/venv/bin/uvicorn'",
          "customName": "Verificar backend"
        }
      ],
      "secrets": [],
      "variables": {
        "UV_PROJECT_ENVIRONMENT": "/app/backend/venv"
      }
    },
    "build": {
      "inputs": [
        {
          "step": "install"
        }
      ],
      "commands": [
        {
          "cmd": "npm --prefix /app/frontend run build",
          "customName": "Construir frontend"
        }
      ],
      "secrets": [],
      "variables": {
        "VITE_API_BASE_URL": "/api/v1"
      }
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "packages:mise",
        "include": [
          "/mise/shims",
          "/mise/installs"
        ]
      },
      {
        "step": "build"
      }
    ],
    "paths": [
      "/app/backend/venv/bin"
    ],
    "startCommand": "sh /app/start.sh",
    "variables": {
      "PLANNER_ALLOWED_HOSTS": "[\"*.up.railway.app\",\"healthcheck.railway.app\",\"habit-tracker.co\",\"www.habit-tracker.co\",\"localhost\",\"127.0.0.1\"]",
      "PLANNER_DATABASE_URL": "sqlite:////data/personal_planner.db",
      "PLANNER_ENVIRONMENT": "production",
      "PLANNER_FRONTEND_DIST": "/app/frontend/dist",
      "PLANNER_FRONTEND_ORIGINS": "[]",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONUNBUFFERED": "1"
    }
  }
}
